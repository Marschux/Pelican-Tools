    "scripts": {
        "installation": {
            "script": "#!/bin/ash\nmkdir -p /mnt/server\ncd /mnt/server\n\nAPI=https://fill.papermc.io/v3/projects/paper\nUA=\"pelican-egg-minecraft-paper\"\n\nif [ -z \"${PAPER_VERSION}\" ] || [ \"${PAPER_VERSION}\" = \"latest\" ]; then\n    # newest first; ids with a dash are pre-releases and release candidates\n    PAPER_VERSION=$(curl -fsSL -A \"$UA\" \"$API/versions\" | jq -r '[.versions[].version.id | select(test(\"-\") | not)][0]')\nfi\n\nBUILD=${BUILD_NUMBER:-latest}\nBUILD_JSON=$(curl -fsSL -A \"$UA\" \"$API/versions/${PAPER_VERSION}/builds/${BUILD}\")\nURL=$(echo \"$BUILD_JSON\" | jq -r '.downloads[\"server:default\"].url // empty')\nSHA=$(echo \"$BUILD_JSON\" | jq -r '.downloads[\"server:default\"].checksums.sha256 // empty')\n\nif [ -z \"$URL\" ] || [ -z \"$SHA\" ]; then\n    echo \"No Paper download found for version ${PAPER_VERSION}, build ${BUILD}\"\n    exit 1\nfi\n\necho \"Downloading Paper ${PAPER_VERSION} build $(echo \"$BUILD_JSON\" | jq -r '.id')\"\ncurl -fsSL -A \"$UA\" -o \"${SERVER_JARFILE}\" \"$URL\" || exit 1\necho \"${SHA}  ${SERVER_JARFILE}\" | sha256sum -c - || exit 1\n\necho 'Install Complete'\n",
            "container": "ghcr.io/pelican-eggs/installers:alpine",
            "entrypoint": "ash"
        }
    },
