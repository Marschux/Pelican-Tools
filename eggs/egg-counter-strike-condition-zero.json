    "scripts": {
        "installation": {
            "script": "#!/bin/bash\ncd /tmp\nmkdir -p /mnt/server/steamcmd\ncurl -sSL -o steamcmd.tar.gz https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz\ntar -xzf steamcmd.tar.gz -C /mnt/server/steamcmd\ncd /mnt/server/steamcmd\n\n# app 90 aborts halfway more often than not, so run it until the files are actually there\nfor try in 1 2 3 4 5; do\n    ./steamcmd.sh +force_install_dir /mnt/server +login anonymous +app_set_config 90 mod czero +app_update 90 validate +quit\n    [[ -f /mnt/server/hlds_run && -f /mnt/server/czero/liblist.gam ]] && break\n    echo \"> Install incomplete, attempt ${try} of 5 ...\"\ndone\n\nif [[ ! -f /mnt/server/hlds_run || ! -f /mnt/server/czero/liblist.gam ]]; then\n    echo \"> steamcmd did not get app 90 down in 5 attempts, aborting.\"\n    exit 1\nfi\n\nmkdir -p /mnt/server/.steam/sdk32 /mnt/server/.steam/sdk64\ncp -v linux32/steamclient.so ../.steam/sdk32/steamclient.so\ncp -v linux64/steamclient.so ../.steam/sdk64/steamclient.so",
            "container": "ghcr.io/parkervcp/installers:debian",
            "entrypoint": "bash"
        }
    },
