  "config": {"files": "{}", "startup": "{\"done\":\"Setting breakpad minidump AppID = 2394010\"}", "logs": "{}", "stop": "shutdown 15"},
  "scripts": {"installation": {"script": "#!/bin/bash\ncd /tmp\nmkdir -p /mnt/server/steamcmd\ncurl -sSL -o steamcmd.tar.gz https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz\ntar -xzf steamcmd.tar.gz -C /mnt/server/steamcmd\ncd /mnt/server/steamcmd\n./steamcmd.sh +force_install_dir /mnt/server +login anonymous +app_update 2394010 validate +quit\nmkdir -p /mnt/server/.steam/sdk32 /mnt/server/.steam/sdk64\ncp -v linux32/steamclient.so ../.steam/sdk32/steamclient.so\ncp -v linux64/steamclient.so ../.steam/sdk64/steamclient.so", "container": "ghcr.io/parkervcp/installers:debian", "entrypoint": "bash"}},
  "variables": [
    {"name": "Server Name", "description": "Name des Servers.", "env_variable": "SERVER_NAME", "default_value": "Palworld Server", "user_viewable": true, "user_editable": true, "rules": "required|string|max:64", "field_type": "text"},
    {"name": "Max Players", "description": "Maximale Spielerzahl.", "env_variable": "MAX_PLAYERS", "default_value": "32", "user_viewable": true, "user_editable": true, "rules": "required|numeric|between:1,32", "field_type": "text"}
  ]
}
