{
  "_comment": "Conan Exiles dedicated server egg.",
  "meta": {"version": "PTDL_v2", "update_url": null},
  "exported_at": "2026-08-10T00:00:00+02:00",
  "name": "Conan Exiles",
  "author": "GrassNotFound",
  "description": "Conan Exiles dedicated server.",
  "features": ["steam_disk_space"],
  "docker_images": {"ghcr.io/parkervcp/yolks:wine_latest": "ghcr.io/parkervcp/yolks:wine_latest"},
  "file_denylist": [],
  "startup": "xvfb-run --auto-servernum wine /home/container/ConanSandbox/Binaries/Win64/ConanSandboxServer-Win64-Shipping.exe -Port={{SERVER_PORT}} -QueryPort={{QUERY_PORT}} -RconPort={{RCON_PORT}} -ServerName=\"{{SERVER_NAME}}\" -ServerPassword=\"{{SERVER_PASSWORD}}\" -log",
  "config": {"files": "{}", "startup": "{}", "logs": "{}", "stop": "^C"},
  "scripts": {"installation": {"script": "#!/bin/bash\ncd /tmp\nmkdir -p /mnt/server/steamcmd\ncurl -sSL -o steamcmd.tar.gz https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz\ntar -xzf steamcmd.tar.gz -C /mnt/server/steamcmd\ncd /mnt/server/steamcmd\n./steamcmd.sh +force_install_dir /mnt/server +login anonymous +app_update 443030 validate +quit\nmkdir -p /mnt/server/.steam/sdk32 /mnt/server/.steam/sdk64\ncp -v linux32/steamclient.so ../.steam/sdk32/steamclient.so\ncp -v linux64/steamclient.so ../.steam/sdk64/steamclient.so", "container": "ghcr.io/parkervcp/installers:debian", "entrypoint": "bash"}},
  "variables": [
    {"name": "Query Port", "description": "Steam query port.", "env_variable": "QUERY_PORT", "default_value": "27015", "user_viewable": false, "user_editable": false, "rules": "required|numeric|between:1000,65535", "field_type": "text"},
    {"name": "RCON Port", "description": "RCON port.", "env_variable": "RCON_PORT", "default_value": "25575", "user_viewable": false, "user_editable": false, "rules": "required|numeric|between:1000,65535", "field_type": "text"},
    {"name": "Server Name", "description": "Name des Servers.", "env_variable": "SERVER_NAME", "default_value": "Conan Exiles Server", "user_viewable": true, "user_editable": true, "rules": "required|string|max:64", "field_type": "text"},
    {"name": "Server Password", "description": "Optionales Serverpasswort.", "env_variable": "SERVER_PASSWORD", "default_value": "", "user_viewable": true, "user_editable": true, "rules": "nullable|string|max:64", "field_type": "text"}
  ]
}
